---
// Collapsible IEEE-style reference list for one tool, with the original link and an archived copy
// kept in the repository for every entry.
import { entryHtml, referencesFor, type ReferenceFile } from "../lib/references.ts";
interface Props { file: ReferenceFile; open?: boolean }
const { file, open = false } = Astro.props;
const { sources } = referencesFor(file);
---
<details class="references" id="references" open={open}>
  <summary>References ({sources.length})</summary>
  <div class="details-body">
  <p class="small muted sans">
    Numbered as cited ([1], [2], …); the numbers are the same on every page of this tool. Each entry links to
    the original and to a copy kept in this site's repository, so the exact version used stays available.
  </p>
  <ol class="ref-list">
    {sources.map((s, i) => (
      <li id={`ref-${s.id}`}><span class="ref-n">[{i + 1}]</span><span class="ref-body" set:html={entryHtml(s)} /></li>
    ))}
  </ol>
  </div>
</details>
