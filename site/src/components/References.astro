---
// Collapsible IEEE-style reference list for one tool: each entry has the original link, the date it was last read,
// and its public copy or why there isn't one (AGENTS.md, principle 3).
import { entryHtml, referencesFor, type ReferenceFile } from "../lib/references.ts";
interface Props { file: ReferenceFile; open?: boolean }
const { file, open = false } = Astro.props;
const { sources } = referencesFor(file);
---
<details class="references" id="references" open={open}>
  <summary>References ({sources.length})</summary>
  <div class="details-body">
  <p class="small muted sans">
    Numbered as cited ([1], [2], …); the numbers are the same on every page of this tool. Each entry links to
    the original and gives the date it was last read and checked. Where the tool's results are calculated from a
    source, and its licence allows, a copy of the exact version used is kept in this site's public archive; the site
    owner keeps a private copy of every source.
  </p>
  <ol class="ref-list">
    {sources.map((s, i) => (
      <li id={`ref-${s.id}`}><span class="ref-n">[{i + 1}]</span><span class="ref-body" set:html={entryHtml(s)} /></li>
    ))}
  </ol>
  </div>
</details>
