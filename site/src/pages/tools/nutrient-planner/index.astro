---
import Base from "../../../layouts/Base.astro";
import { site } from "../../../site.config";
const base = import.meta.env.BASE_URL;
---
<Base title="Nutrient planner" current="nutrient-planner" description="Find a handful of everyday foods that together cover a day's recommended nutrients, or build your own day and see how it measures up.">
  <h1>Nutrient planner</h1>
  <p class="lede">Find a handful of everyday foods that together cover a day's recommended nutrients, or build your own day and see how it measures up.</p>

  <div id="planner" data-base={base} data-refresh-url={site.refreshIssueUrl ?? ""} data-methods-url={`${base}about/`} data-privacy-url={`${base}privacy/`}>
    <noscript><p class="notice">The planner runs in your browser and needs JavaScript.</p></noscript>
    <p id="loading" class="muted">Loading food data…</p>

    <div id="app" hidden>
      <!-- 1. About you -->
      <section class="panel" aria-labelledby="h-you">
        <h2 id="h-you">1. About you</h2>
        <div class="you">
          <fieldset>
            <legend>Sex</legend>
            <div class="segmented">
              <label><input type="radio" name="sex" value="female" /><span>Female</span></label>
              <label><input type="radio" name="sex" value="male" /><span>Male</span></label>
            </div>
          </fieldset>
          <label class="field">Age <span><input id="age" type="number" min="1" max="110" step="1" inputmode="numeric" /> years</span></label>
          <label class="field">Weight <span><input id="weight" type="number" min="10" max="300" step="1" inputmode="numeric" /> kg</span></label>
        </div>
        <p class="profile-line sans" id="profileLine"></p>

        <details id="tuneBox">
          <summary>Fine-tune targets <span class="summary-note" id="tuneNote"></span></summary>
          <div class="details-body">
            <div class="tune-row">
              <fieldset>
                <legend>Recommendations</legend>
                <div class="segmented" id="standardSeg"></div>
              </fieldset>
              <label class="field">Pregnancy or breastfeeding
                <select id="life">
                  <option value="none">Neither</option>
                  <option value="pregnancy">Pregnant</option>
                  <option value="lactation">Breastfeeding</option>
                </select>
              </label>
            </div>
            <p class="small sans" id="sourceLine"></p>
            <fieldset class="energy">
              <legend>Calories per day</legend>
              <span class="cal-row">
                <label>from <input type="number" id="energyLow" min="300" max="6000" step="10" inputmode="numeric" /></label>
                <label>to <input type="number" id="energyHigh" min="300" max="6000" step="10" inputmode="numeric" /></label>
                <button type="button" class="link" id="energyReset" hidden>Reset to recommended</button>
              </span>
              <p class="small muted sans" id="energyNote"></p>
              <p class="notice small" id="energyCustom" hidden>Your calorie range differs from the recommended range for this group.</p>
            </fieldset>
            <p class="small sans">These are the official daily targets for the group above. If your needs differ (for example on medical advice), type your own value; it will be marked <span class="badge">custom</span>.</p>
            <p class="notice" id="customBanner" hidden>Some targets are custom and differ from the official recommendations. <button type="button" class="link" id="resetTargets">Reset all to official values</button></p>
            <div id="targetGroups"></div>
          </div>
        </details>
      </section>

      <!-- 2. Foods -->
      <section class="panel" aria-labelledby="h-foods">
        <h2 id="h-foods">2. Foods</h2>
        <div class="food-head">
          <div class="segmented" role="radiogroup" aria-label="Diet">
            <label><input type="radio" name="diet" value="none" /><span>No restriction</span></label>
            <label><input type="radio" name="diet" value="vegetarian" /><span>Vegetarian</span></label>
            <label><input type="radio" name="diet" value="vegan" /><span>Vegan</span></label>
          </div>
          <span class="sans" id="foodCount"></span>
        </div>
        <details id="foodsBox">
          <summary>Choose foods <span class="summary-note" id="foodsNote"></span></summary>
          <div class="details-body">
            <div class="preset-row sans">
              <span>Start from:</span>
              <button type="button" class="small" data-base="common">Common foods</button>
              <button type="button" class="small" data-base="all">Everything</button>
              <button type="button" class="small" data-base="none">Nothing</button>
            </div>
            <label class="sr-only" for="foodSearch">Search foods</label>
            <input type="search" id="foodSearch" placeholder="Search all foods, e.g. lentils, salmon, cheddar" autocomplete="off" />
            <p class="small muted sans">Tick a category to switch all of it on or off, or open it to choose individual foods. Common foods are marked <span class="tag">common</span>.</p>
            <div id="foodTree"></div>
          </div>
        </details>
      </section>

      <!-- 3. Plan -->
      <section class="panel" aria-labelledby="h-plan">
        <h2 id="h-plan">3. Plan your day</h2>
        <div class="segmented mode" role="radiogroup" aria-label="Mode">
          <label><input type="radio" name="mode" value="suggest" /><span>Suggest foods for me</span></label>
          <label><input type="radio" name="mode" value="build" /><span>Build my own</span></label>
        </div>

        <div id="suggestPane">
          <div class="run-row sans">
            <label>Up to <input type="number" id="n" min="1" max="15" step="1" inputmode="numeric" /> different foods</label>
            <label>Show <input type="number" id="options" min="1" max="5" step="1" inputmode="numeric" /> options</label>
            <button type="button" class="primary" id="run">Find combinations</button>
            <span id="status" class="muted small" role="status" aria-live="polite"></span>
          </div>
          <div id="results"></div>
        </div>

        <div id="buildPane" hidden>
          <p class="sans small">Add the foods you plan to eat in a day and their amounts. The charts update as you go.</p>
          <div class="add-box">
            <label class="sr-only" for="addSearch">Add a food</label>
            <input type="search" id="addSearch" placeholder="Add a food: type to search" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="addList" />
            <ul id="addList" role="listbox" hidden></ul>
          </div>
          <div id="builderList"></div>
          <div id="builderResult"></div>
        </div>
      </section>

      <details id="shareBox">
        <summary>Save or share these settings</summary>
        <div class="details-body sans">
          <p class="small">Your settings are kept in this page's address, so you can bookmark it or send it to someone. Nothing is sent to us.</p>
          <div class="preset-row">
            <button type="button" class="small" id="copyLink">Copy link</button>
            <button type="button" class="small" id="exportBtn">Export settings file</button>
            <label class="button small" for="importFile">Import settings file</label>
            <input type="file" id="importFile" accept="application/json,.json" hidden />
          </div>
          <p class="small"><label><input type="checkbox" id="rememberBox" /> Remember my settings on this device</label> · <button type="button" class="link" id="forgetBtn">Forget</button></p>
          <p class="small muted">Off by default. If ticked, settings are saved in this browser only. <a href={`${base}privacy/`}>Privacy</a></p>
          <p class="small muted" id="dataInfo"></p>
        </div>
      </details>
    </div>
  </div>
</Base>

<script>
  import { start } from "../../../tools/nutrient-planner/ui.ts";
  start(document.getElementById("planner")!);
</script>

<style is:global>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  #planner legend, #planner .field { font-weight: 700; font-size: 0.95rem; }
  #planner .you { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: flex-end; }
  #planner .field { display: flex; flex-direction: column; gap: 4px; }
  #planner .field > span { font-weight: 400; font-family: var(--sans); }
  #planner legend { margin-bottom: 4px; padding: 0; }
  #planner .profile-line { margin: 12px 0 4px; font-size: 0.95rem; }
  #planner .tune-row { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: flex-end; margin-bottom: 10px; }
  #planner .energy { margin: 12px 0; }
  #planner .cal-row { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; font-family: var(--sans); }
  #planner .badge { font-family: var(--sans); font-size: 0.72rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; background: var(--warn-soft); color: var(--warn); margin-left: 6px; white-space: nowrap; }
  #planner td input[type="number"] { width: 6em; padding: 3px 6px; }
  #planner .food-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  #planner .preset-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
  #planner #foodSearch { margin-bottom: 6px; }
  #planner .tree summary { font-weight: 700; }
  #planner .tree summary input, #planner .tree .item input { margin: 0 4px 0 0; transform: translateY(1px); }
  #planner .tree .count { font-family: var(--sans); font-weight: 400; font-size: 0.82rem; color: var(--muted); }
  #planner .tree details[open] > summary .count { color: #dcdcf5; }
  #planner .tree .items { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2px 14px; padding: 6px 10px 8px 26px; font-family: var(--sans); font-size: 0.92rem; }
  #planner .tree .item { display: flex; gap: 4px; align-items: baseline; }
  #planner .tree details details { margin: 2px 0 2px 16px; }
  #planner .tree details details > summary { font-family: var(--sans); font-size: 0.93rem; padding: 3px 8px; }
  #planner .flat { list-style: none; padding: 0; margin: 6px 0; font-family: var(--sans); font-size: 0.92rem; columns: 2 300px; }
  #planner .flat li { break-inside: avoid; margin-bottom: 3px; }
  #planner .flat .path { color: var(--muted); font-size: 0.8rem; }
  #planner .mode { margin-bottom: 14px; }
  #planner .run-row { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; margin-bottom: 8px; }
  #planner .run-row input[type="number"] { width: 4.2em; }
  #planner .result { border: 1px solid var(--line-soft); border-radius: 4px; padding: 14px 16px; margin: 16px 0; background: #fff; }
  #planner .result h3 { margin: 0 0 8px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; align-items: baseline; }
  #planner .headline { font-family: var(--sans); margin: 0 0 8px; }
  #planner .ingredients { list-style: none; padding: 0; margin: 8px 0 12px; display: flex; flex-wrap: wrap; gap: 6px; font-family: var(--sans); font-size: 0.92rem; }
  #planner .ingredients li { background: var(--beige); border: 1px solid var(--line-soft); border-radius: 99px; padding: 3px 12px; }
  #planner .ingredients b { font-weight: 700; }
  #planner .charts { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 8px 20px; align-items: center; }
  @media (max-width: 720px) { #planner .charts { grid-template-columns: 1fr; } }
  #planner svg.radar { width: 100%; height: auto; max-width: 520px; display: block; margin: 0 auto; }
  #planner figure.chart { margin: 0; }
  #planner figure.chart figcaption { text-align: center; font-family: var(--sans); }
  #planner table.contrib th.num { max-width: 9em; white-space: normal; text-align: right; }
  #planner .share { display: inline-block; min-width: 3.2em; padding: 1px 4px; background: linear-gradient(90deg, rgba(45,122,45,0.25) var(--w), transparent var(--w)); }
  #planner .chart-title { margin: 14px 0 0; font-size: 1rem; }
  #planner .side { font-size: 0.9rem; }
  #planner .side h4 { margin: 12px 0 6px; font-size: 0.95rem; }
  #planner .legend, #planner .groups { list-style: none; padding: 0; margin: 0 0 6px; }
  #planner .legend li, #planner .groups li { margin: 3px 0; display: flex; align-items: center; gap: 8px; }
  #planner .sw { display: inline-block; flex: none; }
  #planner .sw.ring { width: 22px; height: 0; border-top: 3px solid #000080; }
  #planner .sw.dot { width: 10px; height: 10px; border-radius: 50%; }
  #planner .sw.line { width: 22px; height: 0; border-top-width: 2px; }
  #planner.no-compare .cmp-only { display: none; }
  #planner .sw.good { background: #2d7a2d; } #planner .sw.bad { background: #a3271c; } #planner .sw.ref { background: #666; }
  #planner .limit { margin-bottom: 8px; }
  #planner .limit .lbar { height: 8px; background: #eeeadb; border-radius: 4px; overflow: hidden; margin-top: 3px; }
  #planner .limit .lbar span { display: block; height: 100%; background: var(--navy); }
  #planner .limit.over .lbar span { background: var(--bad); }
  #planner .chip { font-family: var(--sans); font-size: 0.74rem; font-weight: 700; padding: 1px 8px; border-radius: 99px; white-space: nowrap; }
  #planner .chip.met, #planner .chip.within { background: var(--good-soft); color: var(--good); }
  #planner .chip.short { background: var(--warn-soft); color: var(--warn); }
  #planner .chip.low, #planner .chip.over { background: var(--bad-soft); color: var(--bad); }
  #planner .chip.info, #planner .chip.unassessed { background: #eeeeee; color: #555; }
  #planner .add-box { position: relative; max-width: 560px; }
  #planner #addList { position: absolute; z-index: 5; left: 0; right: 0; top: 100%; background: #fff; border: 1px solid #8c8a78; border-top: none; list-style: none; margin: 0; padding: 0; max-height: 320px; overflow-y: auto; font-family: var(--sans); font-size: 0.92rem; box-shadow: 0 6px 16px rgba(0,0,0,0.12); }
  #planner #addList li { padding: 6px 10px; cursor: pointer; border-bottom: 1px solid #f0eedf; }
  #planner #addList li:hover, #planner #addList li[aria-selected="true"] { background: var(--beige); }
  #planner #addList .path { display: block; color: var(--muted); font-size: 0.78rem; }
  #planner .builder-table { margin: 12px 0; }
  #planner .builder-table td:first-child { min-width: 180px; }
  #planner .builder-table .amt { display: flex; gap: 6px; align-items: center; }
  #planner .builder-table input[type="number"] { width: 6em; padding: 3px 6px; }
  #planner .result-actions { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
