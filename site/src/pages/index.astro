---
import Base from "../layouts/Base.astro";
import { TOOLS, pageHref, STATUS_LABEL } from "../lib/tools.ts";
const base = import.meta.env.BASE_URL;
const topics = [...new Set(TOOLS.map((t) => t.topic))].sort();
---
<Base current="home">
  <h1>Half-Baked Tools</h1>
  <p class="lede">Small, open-source tools for everyday questions. Every tool shows its sources and its limits, and keeps improving as better evidence and data arrive.</p>
  {topics.map((topic) => (
    <section class="tool-group">
      <h2>{topic}</h2>
      <ul class="tool-list">
        {TOOLS.filter((t) => t.topic === topic).map((t) => (
          <li>
            <a class="card" href={pageHref(base, t, "index")}>
              <h3 style="margin-top:0">{t.name} <span class="tag">{STATUS_LABEL[t.status]}</span></h3>
              <p class="muted" style="margin:0">{t.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <h2>Why "half-baked"?</h2>
  <p>Because these tools are never finished. Data gets updated, methods get refined, and anyone can suggest improvements on GitHub. What doesn't change: claims come with sources, and limitations are stated plainly. <a href={`${base}about/`}>More about how the site works</a>.</p>
</Base>
