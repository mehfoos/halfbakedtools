---
import Base from "../layouts/Base.astro";
import { TOOLS, orderedTopics, pageHref, STATUS_LABEL } from "../lib/tools.ts";
const base = import.meta.env.BASE_URL;
const topics = orderedTopics();
---
<Base current="home">
  <h1>Half-Baked Tools</h1>
  <p class="lede">Small, open-source tools and utilities for everyday questions and tasks. They are works in progress.</p>
  {topics.map((topic) => (
    <section class="tool-group">
      <h2>{topic}</h2>
      <ul class="tool-list">
        {TOOLS.filter((t) => t.topic === topic).map((t) => (
          <li>
            <a class="card" href={pageHref(base, t, "index")}>
              <h3 style="margin-top:0">{t.name} <span class="tag">{STATUS_LABEL[t.status]}</span></h3>
              <p class="muted" style="margin:0">{t.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <h2>Why "half-baked"?</h2>
  <p>Because the tools are never finished: expect rough edges, and changes as they are corrected and refined. <a href={`${base}about/`}>More about the site</a>.</p>
</Base>
