---
import Base from "../layouts/Base.astro";
import { TOOLS, orderedTopics, pageHref, STATUS_LABEL } from "../lib/tools.ts";
import { site } from "../site.config.ts";
const base = import.meta.env.BASE_URL;
const topics = orderedTopics();
---
<Base current="home">
  <div id="home">
    <h1 class="lede">Small, free, open-source tools for everyday questions and tasks.</h1>

    <div class="principles">
      <p><b>Evolving.</b> "Half-baked" means never finished, not low quality. Tools are corrected and refined as they go, and each carries an <a href={`${base}about/#status-labels`}>Early version, Beta or Stable label</a> to show where it stands.</p>
      <p><b>Open.</b> The code is MIT-licensed and on <a href={site.repoUrl}>GitHub</a>. Each tool has a methods page explaining how it works.</p>
      <p><b>Cited.</b> Where a tool uses published figures, it links to the original source.</p>
      <p><b>Private.</b> The work happens in your browser. What you enter or open isn't sent to a server. <a href={`${base}privacy/`}>Privacy</a></p>
    </div>

    {topics.map((topic) => (
      <section class="tool-group">
        <h2 class="topic">{topic}</h2>
        <ul class="cards">
          {TOOLS.filter((t) => t.topic === topic).map((t) => (
            <li>
              <a class="card-link" href={pageHref(base, t, "index")}>
                <span class="name">{t.name} <span class="tag">{STATUS_LABEL[t.status]}</span></span>
                <span class="blurb">{t.tagline}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style is:global>
  #home h1.lede { font-size: clamp(1.3rem, 3.4vw, 1.7rem); font-weight: 700; line-height: 1.25; text-align: center; margin: 1.1rem auto 1rem; max-width: 30em; }
  #home ul { list-style: none; padding: 0; margin: 0; }
  #home .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 28px; background: var(--beige); border-radius: 6px; padding: 12px 16px; font-family: var(--sans); font-size: 0.92rem; color: var(--muted); }
  #home .principles p { margin: 0; }
  #home .principles b { font-family: var(--serif); color: var(--accent); font-size: 1.02rem; }
  #home h2.topic { font-size: 1.15rem; margin: 1.4em 0 0.5em; border-bottom: 1px solid var(--line-soft); padding-bottom: 0.2em; }
  #home .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
  #home .card-link { display: block; height: 100%; box-sizing: border-box; padding: 10px 14px; border: 1px solid var(--line-soft); border-radius: 6px; background: #fff; color: inherit; text-decoration: none; transition: border-color 0.15s, background 0.15s; }
  #home .card-link:hover, #home .card-link:focus-visible { border-color: var(--navy); background: var(--beige); }
  #home .card-link .name { display: block; font-weight: 700; font-size: 1.08rem; color: var(--navy); line-height: 1.3; }
  #home .card-link .blurb { display: block; font-family: var(--sans); font-size: 0.92rem; color: var(--muted); margin-top: 2px; }
  @media (max-width: 560px) { #home .principles { grid-template-columns: 1fr; } }
</style>
