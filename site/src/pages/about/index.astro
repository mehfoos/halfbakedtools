---
import Base from "../../layouts/Base.astro";
import { site } from "../../site.config.ts";
import { TOOLS, pageHref } from "../../lib/tools.ts";
const base = import.meta.env.BASE_URL;
const methods = TOOLS.filter((t) => t.pages.some((p) => p.page === "methods"));
---
<Base title="About" current="about">
  <h1>About</h1>
  <p class="lede">A small, growing collection of free tools. Some help work something out; others are simple utilities.</p>

  <h2>What to expect</h2>
  <ul class="prose">
    <li><strong>Works in progress.</strong> The tools are unfinished and may contain mistakes. For anything that matters, check the original source or ask a professional.</li>
    <li><strong>Sources, where a tool relies on them.</strong> Tools built on published figures cite them, with a link to the original and to a copy kept in this site's repository. Their methods pages say what has been checked and what hasn't.</li>
    <li><strong>Runs in your browser.</strong> The tools do their work on your device; what you enter or open isn't sent to a server. See <a href={`${base}privacy/`}>Privacy</a>.</li>
    <li><strong>Open source.</strong> The code and data are on <a href={site.repoUrl}>GitHub</a>. Corrections are welcome there.</li>
  </ul>

  {methods.length > 0 && (
    <Fragment>
      <h2>Methods and sources</h2>
      <ul class="prose">
        {methods.map((t) => <li><a href={pageHref(base, t, "methods")}>{t.name}</a></li>)}
      </ul>
    </Fragment>
  )}

  <h2>Status labels</h2>
  <ul class="prose">
    <li><strong>Early version:</strong> works, with rough edges; likely to change.</li>
    <li><strong>Beta:</strong> the main features are in place; still being checked and refined.</li>
    <li><strong>Stable:</strong> expected to change little.</li>
  </ul>

  <p class="small muted">Information only. Nothing on this site is medical, financial or legal advice.</p>
</Base>
