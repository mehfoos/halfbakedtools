---
import Base from "../../layouts/Base.astro";
import { site } from "../../site.config.ts";
import { TOOLS, pageHref } from "../../lib/tools.ts";
const base = import.meta.env.BASE_URL;
const methods = TOOLS.filter((t) => t.pages.some((p) => p.page === "methods"));
---
<Base title="About" current="about">
  <h1>About Half-Baked Tools</h1>
  <p class="lede">What every tool on this site promises, and how you can check it.</p>

  <h2>What every tool does</h2>
  <ul class="prose">
    <li><strong>Accuracy before features.</strong> Numbers are checked line by line against the original documents, and each tool says what has and hasn't been checked yet. Where a tool is unsure, it says so rather than guessing.</li>
    <li><strong>Every claim is referenced.</strong> Sources are cited with numbers like [1], and each tool's reference list links to the original and to a copy kept in this site's repository, so the exact version used stays available even if the original moves or changes.</li>
    <li><strong>Methods and limits are written down.</strong> Each tool has a methods page explaining how it works and what it can't tell you.</li>
    <li><strong>Your data stays with you.</strong> Calculations run in your browser; nothing you enter is sent anywhere. See <a href={`${base}privacy/`}>Privacy</a>.</li>
    <li><strong>Open source.</strong> All code, data, references and verification notes are on <a href={site.repoUrl}>GitHub</a>, where anyone can report a problem.</li>
  </ul>

  <h2>Methods for each tool</h2>
  <ul class="prose">
    {methods.map((t) => <li><a href={pageHref(base, t, "methods")}>{t.name}: methods and sources</a></li>)}
  </ul>

  <h2>Status labels</h2>
  <ul class="prose">
    <li><strong>Early version:</strong> working, but expect rough edges and changes.</li>
    <li><strong>Beta:</strong> complete and checked against its sources; still being refined.</li>
    <li><strong>Stable:</strong> unlikely to change except for data updates.</li>
  </ul>

  <p class="small muted">Information only. Nothing on this site is medical, financial or legal advice.</p>
</Base>
