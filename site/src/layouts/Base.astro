---
import "../styles/global.css";
import { site } from "../site.config.ts";

interface Props { title?: string; description?: string; current?: string }
const { title, description = site.tagline, current = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const nav = [
  { href: base, label: "Tools", id: "home" },
  { href: `${base}about/`, label: "About", id: "about" },
  { href: `${base}privacy/`, label: "Privacy", id: "privacy" },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}brand/logo.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}brand/apple-touch-icon.png`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="wrap">
      <div class="title-heading">
        <a class="logo" href={base}><img src={`${base}brand/logo.svg`} alt="Half-Baked Tools home" width="72" height="72" /></a>
        <p class="site-title"><a href={base}>HALF-BAKED TOOLS</a></p>
        <div class="spacer" aria-hidden="true"></div>
      </div>
      <nav aria-label="Main">
        <ul class="nav-menu">
          {nav.map((n) => <li><a href={n.href} aria-current={n.id === current ? "page" : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <ul class="nav-menu">
        <li><a href={site.repoUrl}>Source on GitHub</a></li>
        <li><a href={`${base}about/`}>About</a></li>
        <li><a href={`${base}privacy/`}>Privacy</a></li>
      </ul>
      <p>{site.tagline} No cookies, no tracking. Information only; not medical, financial or legal advice.</p>
    </footer>
    <script>
      // Citation links point into a collapsible reference list: open it before jumping.
      const openRef = (hash: string) => {
        if (!hash.startsWith("#ref-")) return;
        const el = document.getElementById(hash.slice(1));
        const box = el?.closest("details");
        if (box) box.open = true;
        el?.classList.add("ref-target");
        el?.scrollIntoView({ block: "center" });
      };
      document.addEventListener("click", (e) => {
        const a = (e.target as Element | null)?.closest?.("a.cite") as HTMLAnchorElement | null;
        if (a) { e.preventDefault(); history.replaceState(null, "", a.hash); document.querySelectorAll(".ref-target").forEach((x) => x.classList.remove("ref-target")); openRef(a.hash); }
      });
      openRef(location.hash);
    </script>
  </body>
</html>
