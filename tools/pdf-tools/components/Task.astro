    #pdftools .tile { border: 2px solid var(--line-soft); border-radius: 4px; background: #fff; }
    #pdftools .tile.on { border-color: var(--navy); background: #eef0fb; }
    #pdftools .tile.drop-before { box-shadow: -4px 0 0 var(--link-hover); }
    #pdftools .tile.drop-after { box-shadow: 4px 0 0 var(--link-hover); }
    #pdftools .tile label { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 6px; cursor: pointer; font-family: var(--sans); }
    #pdftools .thumb { width: 112px; height: 112px; display: flex; align-items: center; justify-content: center; text-align: center; background: var(--beige); }
    #pdftools .thumb img { max-width: 100%; max-height: 100%; box-shadow: 0 0 0 1px #999; background: #fff; transition: transform 0.15s; }
    #pdftools .from { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #pdftools .files { list-style: none; padding: 0; margin: 0; }
    #pdftools .files li { padding: 4px 0; border-bottom: 1px solid var(--line-soft); overflow-wrap: anywhere; }
    #pdftools .files li.missing { background: var(--warn-soft); padding-left: 6px; }

    #pdftools .side { border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; background: #fff; }
    #pdftools .side-title { font-size: 1.5rem; margin: 0 0 0.4em; text-align: center; border-bottom: 1px solid var(--line-soft); padding-bottom: 0.4em; }
    #pdftools .opts p { margin: 0 0 0.7em; }
    #pdftools .field input, #pdftools .field select { margin: 2px 4px; font: inherit; padding: 3px 5px; max-width: 100%; }
    #pdftools .field input[type="number"] { width: 5em; }
    #pdftools .go { display: flex; flex-direction: column; gap: 8px; margin: 12px -14px 0; padding: 10px 14px; position: sticky; bottom: 0; background: #fff; border-top: 1px solid var(--line-soft); z-index: 3; }
    #pdftools .go .big { width: 100%; }
    #pdftools .result { border: 2px solid var(--good); border-radius: 6px; padding: 10px; margin: 10px 0; background: var(--good-soft); }
    #pdftools .result.same { border-color: var(--warn); background: var(--warn-soft); }
    #pdftools .result table { font-size: 0.85rem; background: #fff; }
    #pdftools .formfields label.ff { display: block; margin: 6px 0; }
    #pdftools .formfields label.ff > span { display: block; font-size: 0.85rem; color: var(--muted, #555); }
    #pdftools .formfields input[type="text"], #pdftools .formfields textarea, #pdftools .formfields select { width: 100%; max-width: 32em; box-sizing: border-box; }
    #pdftools .result del { background: #fdd; color: #900; }
    #pdftools .result ins { background: #dfd; color: #060; text-decoration: underline; }
    #pdftools .result .cmp { margin: 6px 0; padding: 6px; background: #fff; border-radius: 4px; max-height: 14em; overflow: auto; font-size: 0.9rem; line-height: 1.5; }
    #pdftools .result .big-number { font-size: 1.5rem; font-weight: 700; margin: 0; }
    #pdftools .result .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 8px 0; }
    #pdftools .result .pair figure { margin: 0; }
    #pdftools .result .pair canvas { width: 100%; height: auto; display: block; box-shadow: 0 0 0 1px #999; background: #fff; cursor: zoom-in; }
    #pdftools .result .pair.zoom { grid-template-columns: 1fr; }
    #pdftools .result .pair.zoom canvas { cursor: zoom-out; }
    #pdftools .result figcaption { font-size: 0.8rem; text-align: center; }
    #pdftools .stage { position: relative; line-height: 0; box-shadow: 0 0 0 1px #999; background: #fff; touch-action: none; }
    #pdftools .stage canvas { width: 100%; height: auto; display: block; }
    #pdftools .layer { position: absolute; inset: 0; overflow: hidden; }
    #pdftools .mark { position: absolute; transform-origin: 0 0; outline: 1px dashed rgba(0, 0, 128, 0.45); cursor: move; box-sizing: border-box; }
    #pdftools .mark:hover, #pdftools .mark:focus-visible { outline: 2px solid var(--link-hover); }
    #pdftools .mark.sel { outline: 2px solid var(--navy); background: rgba(0, 0, 128, 0.06); }
    #pdftools .mark.area { outline: 1px solid #c00000; }
    #pdftools .mark.area.sel { outline: 2px solid #c00000; background: transparent; }
    #pdftools .mark.area.live { background: rgba(0, 0, 0, 0.35); pointer-events: none; }
    #pdftools .grip { position: absolute; right: -7px; bottom: -7px; width: 14px; height: 14px; background: var(--navy); border: 2px solid #fff; cursor: nwse-resize; }
    #pdftools .props { border: 1px solid var(--navy); border-radius: 6px; padding: 10px; margin-bottom: 12px; background: #f6f7fd; }
    #pdftools .props textarea { width: 100%; font: inherit; padding: 4px; box-sizing: border-box; }
    #pdftools .tile .edit { margin-top: 2px; }
    #pdftools .sigpad { border: 2px solid var(--navy); border-radius: 6px; padding: 10px; margin: 0 0 10px; background: #fff; }
    #pdftools .sigpad canvas { width: 100%; display: block; background: repeating-linear-gradient(#fff, #fff 38px, #e6e6dc 39px); box-shadow: 0 0 0 1px #999; touch-action: none; cursor: crosshair; }
    #pdftools .layer.drawing { cursor: crosshair; touch-action: none; }
    #pdftools .layer.drawing .mark { pointer-events: none; }
    #pdftools .layer svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    #pdftools .cropper { max-width: 520px; margin: 0 auto 14px; }
    #pdftools .cropnav { justify-content: center; align-items: center; margin-bottom: 6px; }
    #pdftools .crbox { position: absolute; box-sizing: border-box; border: 2px solid var(--navy); box-shadow: 0 0 0 9999px rgba(0, 0, 40, 0.45); cursor: move; touch-action: none; }
    #pdftools .ch { position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; background: #fff; border: 2px solid var(--navy); box-sizing: border-box; touch-action: none; }
    #pdftools .ch[data-h="nw"] { left: 0; top: 0; cursor: nwse-resize; } #pdftools .ch[data-h="n"] { left: 50%; top: 0; cursor: ns-resize; } #pdftools .ch[data-h="ne"] { left: 100%; top: 0; cursor: nesw-resize; }
    #pdftools .ch[data-h="w"] { left: 0; top: 50%; cursor: ew-resize; } #pdftools .ch[data-h="e"] { left: 100%; top: 50%; cursor: ew-resize; }
    #pdftools .ch[data-h="sw"] { left: 0; top: 100%; cursor: nesw-resize; } #pdftools .ch[data-h="s"] { left: 50%; top: 100%; cursor: ns-resize; } #pdftools .ch[data-h="se"] { left: 100%; top: 100%; cursor: nwse-resize; }
    #pdftools .cropper .stage { overflow: hidden; }
    #pdftools .preview { max-width: 440px; margin: 0 auto 14px; }
    #pdftools .preview p { text-align: center; margin: 0 0 4px; }
    #pdftools .result .go-result .big { width: 100%; }
    #pdftools .ask { border-width: 2px; }
    #pdftools .ask p { margin: 0 0 0.5em; }
    #pdftools .row { display: flex; flex-wrap: wrap; gap: 8px; }
    @media (max-width: 760px) {
      #pdftools .work { grid-template-columns: 1fr; }
      /* On a phone the action button stays at the bottom of the screen, whatever is scrolled. */
      #pdftools .go { position: fixed; left: 0; right: 0; bottom: 0; margin: 0; padding: 8px 16px; background: #fff; border-top: 1px solid var(--line); z-index: 5; }
      #pdftools .work { padding-bottom: 130px; }
      #pdftools .bar { position: static; }
      #pdftools .big { font-size: 1.1rem; padding: 12px 20px; }
    }
  </style>
</ToolLayout>
