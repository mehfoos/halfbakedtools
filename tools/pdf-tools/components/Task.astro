---
// One task page (Merge PDF, Split PDF, ...). Every task uses this same workspace; web/tasks.ts says which
// controls each one shows. Layout: a big "select files" button first, then page previews with the task's
// options and one action button beside them.
import ToolLayout from "@site/layouts/ToolLayout.astro";
import { CSP } from "../web/csp.ts";
import { taskBySlug, ACCEPT } from "../web/tasks.ts";
interface Props { task: string }
const task = taskBySlug(Astro.props.task);
const base = import.meta.env.BASE_URL;
const home = `${base}tools/pdf-tools/`;
const vendor = `${home}vendor/pdfjs/`;
// The security policy is left off the development server only, whose live-reload needs connections it would block.
const policy = import.meta.env.PROD ? CSP : "";
---
<ToolLayout slug="pdf-tools" page={task.slug} title={`${task.name} · PDF tools`} description={`${task.blurb} Done inside your browser: your files are never uploaded.`}>
  {policy && <meta slot="head" http-equiv="Content-Security-Policy" content={policy} />}
  <div id="pdftools" data-vendor={vendor} data-task={task.slug}>
    <input id="picker" class="sr-only" type="file" multiple accept={ACCEPT[task.accept]} />
    <input id="stampPicker" class="sr-only" type="file" accept={ACCEPT.image} data-part="marks" />

    <section id="hero" class="hero">
      <h1>{task.name}</h1>
      <p class="lede">{task.blurb}</p>
      <noscript><p class="notice">This tool runs in your browser and needs JavaScript.</p></noscript>
      <div id="drop" class="drop sans">
        <label class="button big" for="picker">{task.pick}</label>
        <span class="small muted">or drop {task.accept === "image" ? "images" : task.accept === "pdf" ? "PDFs" : "PDFs or images"} here</span>
      </div>
      <p class="lock sans small"><strong>Your files stay on your device.</strong> They are opened and changed by your own browser and are never uploaded. <a href={`${home}methods/`}>How this works, and how to check it</a>.</p>
      <p class="small sans"><a href={home}>All PDF tools</a></p>
    </section>

    <div id="work" class="work" hidden>
      <div class="main">
        <p class="crumbline sans small"><a href={home}>All PDF tools</a> › <strong>{task.name}</strong> <span class="summary-note" id="selNote"></span></p>
        <div id="editor" data-part="marks" hidden>
          <div class="bar sans" role="toolbar" aria-label="Editing">
            <button type="button" class="small" id="edBack">◀ All pages</button>
            <button type="button" class="small" id="edPrev" aria-label="Previous page">‹</button>
            <span id="edWhere" class="small"></span>
            <button type="button" class="small" id="edNext" aria-label="Next page">›</button>
            <button type="button" class="small add" id="edText">＋ Text</button>
            <label class="button small add" for="stampPicker">＋ Picture</label>
            <button type="button" class="small add" id="edRect" data-part="shapes">▭ Rectangle</button>
            <button type="button" class="small add" id="edEllipse" data-part="shapes">◯ Ellipse</button>
            <button type="button" class="small add" id="edLine" data-part="shapes">╱ Line</button>
            <button type="button" class="small add" id="edHi" data-part="shapes">▬ Highlight</button>
            <button type="button" class="small add" id="edDraw" data-part="shapes" aria-pressed="false">✎ Draw</button>
            <span id="penBar" class="small" data-part="shapes" hidden>Pen <input id="penColor" type="color" value="#c00000" aria-label="Pen colour" />
              <select id="penWidth" aria-label="Pen width"><option value="1.5">Thin</option><option value="3" selected>Medium</option><option value="6">Thick</option></select> Drag on the page to draw.</span>
            <button type="button" class="small add" id="edSign" data-part="sign">✍ Draw signature</button>
            <button type="button" class="small" data-act="undo" id="edUndo">Undo</button>
          </div>
          <div id="sigPad" class="sigpad sans" data-part="sign" hidden>
            <p class="small"><strong>Draw your signature</strong> with your mouse, finger or pen.</p>
            <canvas id="sigCanvas" aria-label="Signature drawing area"></canvas>
            <p class="row small">
              <label class="field">Ink <select id="sigInk"><option value="#10157a">Dark blue</option><option value="#000000">Black</option></select></label>
              <label class="field">Pen <select id="sigWidth"><option value="2">Thin</option><option value="3" selected>Medium</option><option value="5">Thick</option></select></label>
            </p>
            <p class="row">
              <button type="button" class="small" id="sigUndo">Undo stroke</button>
              <button type="button" class="small" id="sigClear">Clear</button>
              <button type="button" class="small" id="sigCancel">Cancel</button>
              <button type="button" class="small add" id="sigUse">Use this signature</button>
            </p>
            <p class="small muted">Your drawing stays in this page. It is not sent anywhere and is not remembered when you leave.</p>
          </div>
          <div id="edStage" class="stage"><canvas></canvas><div id="edLayer" class="layer"></div></div>
          <p class="small muted sans">Drag an addition to move it; drag a picture's corner square to resize it. With one selected, the arrow keys nudge it and Delete removes it. What you see is the page exactly as it will be saved.</p>
        </div>
        <div id="cropper" class="cropper" data-part="crop" hidden>
          <div class="row sans small cropnav">
            <button type="button" class="small" id="crPrev" aria-label="Previous page">‹</button>
            <span id="crWhere"></span>
            <button type="button" class="small" id="crNext" aria-label="Next page">›</button>
          </div>
          <div id="crStage" class="stage">
            <canvas></canvas>
            <div id="crBox" class="crbox">
              <span class="ch" data-h="nw"></span><span class="ch" data-h="n"></span><span class="ch" data-h="ne"></span>
              <span class="ch" data-h="w"></span><span class="ch" data-h="e"></span>
              <span class="ch" data-h="sw"></span><span class="ch" data-h="s"></span><span class="ch" data-h="se"></span>
            </div>
          </div>
          <p class="small sans muted" id="crNote"></p>
        </div>
        <div id="preview" class="preview" data-part="preview" hidden>
          <p class="small sans muted" id="previewNote"></p>
          <div class="stage"><canvas></canvas></div>
        </div>
        <div id="gridView">
        <div class="bar sans" role="toolbar" aria-label="Page actions">
          <label class="button small add" for="picker">＋ Add files</label>
          <button type="button" class="small" data-part="select" data-act="all">Select all</button>
          <button type="button" class="small" data-part="select" data-act="none" data-needs-sel>Select none</button>
          <button type="button" class="small" data-part="move" data-act="earlier" data-needs-sel>◀ Move earlier</button>
          <button type="button" class="small" data-part="move" data-act="later" data-needs-sel>Move later ▶</button>
          <button type="button" class="small" data-part="turn" data-act="left" data-needs-sel>⟲ Turn left</button>
          <button type="button" class="small" data-part="turn" data-act="right" data-needs-sel>⟳ Turn right</button>
          <button type="button" class="small" data-part="duplicate" data-act="duplicate" data-needs-sel>Duplicate</button>
          <button type="button" class="small" data-part="remove" data-act="remove" data-needs-sel>Remove</button>
          <button type="button" class="small" id="undo" data-act="undo">Undo</button>
        <div id="pagerHead" class="pagerrow sans small">
          <span id="showing" class="showing" aria-live="polite"></span>
          <span id="pagerTop" class="pager" role="navigation" aria-label="Pages: choose which pages to show" hidden></span>
          <label id="perRow" class="field" hidden>Pages per screen
            <select id="perScreen"><option value="0">Fit my screen</option><option value="12">12</option><option value="24">24</option><option value="48">48</option></select></label>
        </div>
        </div>
        <div id="gridPart">
          <ul id="grid" class="grid"></ul>
          <div id="pagerBottom" class="pager pagerrow sans small" role="navigation" aria-label="Pages: choose which pages to show" hidden></div>
        </div>
        </div>
        <p id="waiting" class="notice small" hidden></p>
        <details id="filesBox" hidden>
          <summary>Files added</summary>
          <div class="details-body"><ul id="files" class="files sans small"></ul></div>
        </details>
      </div>

      <aside class="side" aria-labelledby="h-task">
        <h1 id="h-task" class="side-title">{task.name}</h1>
        <p class="small sans">{task.hint}</p>

        <div id="markProps" class="sans opts props" data-part="marks" hidden>
          <p data-for="text"><label for="mText">Text</label><br /><textarea id="mText" rows="3"></textarea></p>
          <p id="mWarn" class="notice small" hidden></p>
          <p data-for="text"><label class="field">Size <input id="mSize" type="number" min="4" max="400" step="1" inputmode="decimal" /> points</label></p>
          <p data-for="text"><label class="field">Font
            <select id="mFont"><option value="sans">Plain (Helvetica)</option><option value="serif">Book (Times)</option><option value="mono">Typewriter (Courier)</option></select></label></p>
          <p data-for="text"><label><input id="mBold" type="checkbox" /> Bold</label></p>
          <p data-for="text"><label class="field">Colour <input id="mColor" type="color" /></label></p>
          <p data-for="shape ink"><label class="field">Line colour <input id="mStroke" type="color" /></label></p>
          <p data-for="shape ink"><label class="field">Line width <input id="mLine" type="number" min="0" max="100" step="0.5" inputmode="decimal" /> points</label></p>
          <p data-for="shape"><label><input id="mFillOn" type="checkbox" /> Fill</label> <input id="mFill" type="color" aria-label="Fill colour" /></p>
          <p data-for="shape" id="mFlipRow"><label><input id="mFlip" type="checkbox" /> Other diagonal</label></p>
          <p data-for="shape ink"><label class="field">Strength <input id="mOpacity" type="range" min="5" max="100" step="5" /> <span id="mOpacityNote" class="small"></span></label><br /><span class="small muted">Fainter lets more of the page show through.</span></p>
          <p><label class="field">Turn by <input id="mRotate" type="number" min="-360" max="360" step="1" inputmode="numeric" />°</label> <span class="small muted">clockwise</span></p>
          <p><button type="button" class="small" id="mDelete">Remove this addition</button></p>
        </div>

        <div id="more" class="sans opts">
          <p data-part="selectText"><label class="field">Select pages <input id="selText" type="text" placeholder="1-3, 5, 8-" size="10" /></label>
            <button type="button" class="small" data-act="selectRange">Select</button><br /><span class="small muted">"8-" means page 8 to the end.</span></p>
          <p data-part="moveTo"><label class="field">Move selected to position <input id="movePos" type="number" min="1" step="1" inputmode="numeric" /></label>
            <button type="button" class="small" data-act="moveTo" data-needs-sel>Move</button></p>
          <p data-part="scale"><label class="field">Resize <span id="scaleWho">all pages</span> to <input id="scalePct" type="number" min="10" max="1000" step="1" value="100" inputmode="decimal" /> %</label>
            <button type="button" class="small" data-act="scale">Resize</button><br /><span class="small muted">Of the original size. The paper size and everything on the page change together: 50% halves both the width and the height.</span></p>
        </div>

        <div id="savePanel" class="sans opts">
          <p id="formatField"><label class="field">Save as
            <select id="format">
              <option value="pdf">PDF</option>
              <option value="png">PNG images</option>
              <option value="jpeg">JPEG images</option>
              <option value="webp">WebP images</option>
              <option value="tiff">TIFF images</option>
              <option value="bmp">BMP images</option>
              <option value="txt">Plain text (.txt)</option>
            </select></label></p>
          <div id="optPdf" data-part="split">
            <p><label class="field">Files
              <select id="split">
                <option value="none">One PDF</option>
                <option value="each">One PDF per page</option>
                <option value="every">A new PDF every few pages</option>
                <option value="ranges">Split at the pages I choose</option>
              </select></label></p>
            <p id="optEvery"><label class="field">Pages in each PDF <input id="every" type="number" min="1" step="1" inputmode="numeric" /></label></p>
            <p id="optRanges"><label class="field">Pages for each PDF <input id="ranges" type="text" placeholder="1-3, 4-10" size="12" /></label><br /><span class="small muted">One PDF per comma-separated group.</span></p>
          </div>
          <div id="optImage">
            <p><label class="field">Detail <input id="dpi" type="number" min="36" max="600" step="1" inputmode="numeric" /> dots per inch</label><br /><span class="small muted">More dots: sharper pictures and bigger files.</span></p>
            <p id="optQuality"><label class="field">Quality <input id="quality" type="number" min="10" max="100" step="1" inputmode="numeric" /> %</label><br /><span class="small muted">Lower: smaller files, more blur and blockiness.</span></p>
            <p class="small muted">Each page becomes a picture; its text can no longer be selected. TIFF and BMP are saved uncompressed, so they are large.</p>
          </div>
          <div id="optText">
            <p class="small muted">Words are saved in the order the PDF stores them, which is usually but not always reading order.</p>
          </div>
          <div id="optNumbers" data-part="numbers">
            <p id="nOnRow"><label><input id="nOn" type="checkbox" /> Add page numbers</label></p>
            <div id="nFields">
              <p><label class="field">Position
                <select id="nPos">
                  <option value="bottom-center">Bottom, centre</option><option value="bottom-right">Bottom, right</option><option value="bottom-left">Bottom, left</option>
                  <option value="top-center">Top, centre</option><option value="top-right">Top, right</option><option value="top-left">Top, left</option>
                </select></label></p>
              <p><label class="field">Style
                <select id="nStyle">
                  <option value="n">1</option><option value="n-of-total">1 / 5</option><option value="page-n">Page 1</option><option value="page-n-of-total">Page 1 of 5</option>
                </select></label></p>
              <p><label class="field">First number <input id="nStart" type="number" min="0" step="1" inputmode="numeric" /></label></p>
              <p><label class="field">Start on page <input id="nFrom" type="number" min="1" step="1" inputmode="numeric" /></label><br /><span class="small muted">2 leaves a cover page without a number.</span></p>
              <details>
                <summary>Size, margin and typeface</summary>
                <div class="details-body">
                  <p><label class="field">Size <input id="nSize" type="number" min="4" max="400" step="1" inputmode="decimal" /> points</label></p>
                  <p><label class="field">From the edge <input id="nMargin" type="number" min="0" max="400" step="1" inputmode="decimal" /> points</label><br /><span class="small muted">72 points is one inch (2.54 cm).</span></p>
                  <p><label class="field">Typeface
                    <select id="nFont"><option value="sans">Plain (Helvetica)</option><option value="serif">Book (Times)</option><option value="mono">Typewriter (Courier)</option></select></label></p>
                  <p><label><input id="nBold" type="checkbox" /> Bold</label></p>
                  <p><label class="field">Colour <input id="nColor" type="color" /></label></p>
                </div>
              </details>
              <p class="small muted">Numbers count within each saved file. They are added on top of the page; if a page already has a number printed there, both will show.</p>
            </div>
          </div>
          <div id="optWatermark" data-part="watermark">
            <p id="wOnRow"><label><input id="wOn" type="checkbox" /> Add a watermark</label></p>
            <div id="wFields">
              <p><label class="field">Words <input id="wText" type="text" maxlength="200" size="16" /></label></p>
              <p><label class="field">Layout
                <select id="wLayout"><option value="center">Once, in the middle</option><option value="tile">Repeated across the page</option></select></label></p>
              <p><label class="field">Direction
                <select id="wAngle"><option value="-45">Diagonal, rising</option><option value="0">Level</option><option value="45">Diagonal, falling</option><option value="-90">Up the page</option></select></label></p>
              <p><label class="field">Strength <input id="wOpacity" type="range" min="5" max="100" step="5" /> <span id="wOpacityNote" class="small"></span></label><br /><span class="small muted">Fainter lets more of the page show through.</span></p>
              <p><label class="field">Size <input id="wSize" type="number" min="4" max="400" step="1" inputmode="decimal" /> points</label></p>
              <details>
                <summary>Typeface and colour</summary>
                <div class="details-body">
                  <p><label class="field">Typeface
                    <select id="wFont"><option value="sans">Plain (Helvetica)</option><option value="serif">Book (Times)</option><option value="mono">Typewriter (Courier)</option></select></label></p>
                  <p><label><input id="wBold" type="checkbox" /> Bold</label></p>
                  <p><label class="field">Colour <input id="wColor" type="color" /></label></p>
                </div>
              </details>
              <p class="small muted">The watermark is drawn on top of each page as ordinary see-through text. It marks a document; it does not protect it: someone with PDF software can remove it.</p>
            </div>
          </div>
          <div id="optCrop" data-part="crop">
            <p><label class="field">Measure in
              <select id="crUnit"><option value="mm">millimetres</option><option value="in">inches</option><option value="pt">points</option></select></label></p>
            <p class="small muted">How much to cut off each edge:</p>
            <p><label class="field">Top <input id="crTop" type="number" min="0" step="any" inputmode="decimal" /></label>
               <label class="field">Bottom <input id="crBottom" type="number" min="0" step="any" inputmode="decimal" /></label></p>
            <p><label class="field">Left <input id="crLeft" type="number" min="0" step="any" inputmode="decimal" /></label>
               <label class="field">Right <input id="crRight" type="number" min="0" step="any" inputmode="decimal" /></label></p>
            <p><label class="field">Crop
              <select id="crWhich"><option value="all">every page</option><option value="some">only the pages I choose</option></select></label></p>
            <p id="crPagesRow"><label class="field">Pages <input id="crPages" type="text" placeholder="1-3, 8-" size="12" /></label><br /><span class="small muted">"8-" means page 8 to the end.</span></p>
            <p class="small muted">The same margins are used on every page chosen, so pages of different sizes lose the same width. <strong>Cropping hides; it does not delete.</strong> Anything outside the box is still stored in the PDF, and some software can show it again. For information that must be gone, wait for the Redact tool.</p>
            <p><button type="button" class="small" id="crReset">Reset margins</button></p>
          </div>
          <details id="optImages" data-part="imagePage">
            <summary>Page size and margin for pictures</summary>
            <div class="details-body">
              <p><label class="field">Measure in
                <select id="imUnit"><option value="mm">millimetres</option><option value="in">inches</option><option value="pt">points</option></select></label></p>
              <p><label class="field">Page
                <select id="imSize"><option value="picture">Same size as the picture</option><option value="custom">A size I choose</option></select></label></p>
              <div id="imCustom">
                <p><label class="field">Width <input id="imW" type="number" min="1" step="any" inputmode="decimal" /></label>
                   <label class="field">Height <input id="imH" type="number" min="1" step="any" inputmode="decimal" /></label></p>
                <p><label class="field">Direction
                  <select id="imOrient"><option value="auto">Follow each picture's shape</option><option value="portrait">Always upright (taller than wide)</option><option value="landscape">Always sideways (wider than tall)</option></select></label></p>
              </div>
              <p><label class="field">Margin <input id="imMargin" type="number" min="0" step="any" inputmode="decimal" /></label><br /><span class="small muted">Space around the picture on every side. A picture is never enlarged, only shrunk to fit inside the margins; it is centred. The small previews show the picture alone.</span></p>
              <p class="small muted">PDF pages can be between half an inch and 200 inches on a side.</p>
            </div>
          </details>
          <div id="optCompare" data-part="compare">
            <p class="small muted">The first file you added is the original and the second is the changed version. The result lists, page by page, the words only in the original (struck through) and the words only in the changed version (underlined), and can show the two pages next to each other. It reads text, so scanned pages and pictures show no differences, and a page that has been re-laid-out shows many.</p>
          </div>
          <div id="optExtract" data-part="extractPics">
            <p><label class="field">Skip pictures smaller than <input id="exMin" type="number" min="1" max="2000" step="1" value="32" inputmode="numeric" /> pixels</label><br /><span class="small muted">On either side. Small ones are usually bullets, icons and lines. Skipped ones are counted in the message.</span></p>
            <p class="small muted">JPEG pictures are copied out exactly as stored, with no change in quality. Other pictures are saved as PNG, which keeps every pixel. Pictures with unusual colour setups (such as CMYK), scanned-fax kinds and black-and-white stencil masks are not extracted yet; the message says how many were left out. Clipping, scaling and colour effects the PDF applies when it draws a picture are not applied: you get the stored picture.</p>
          </div>
          <div id="optProtect" data-part="protect">
            <p><label class="field">Password <input id="pw1" type="password" autocomplete="off" size="16" /></label></p>
            <p><label class="field">Type it again <input id="pw2" type="password" autocomplete="off" size="16" /></label></p>
            <p><label><input id="pwShow" type="checkbox" /> Show the password</label></p>
            <p class="small muted">Anyone opening the saved PDF must type this password. Keep it safe: if it is lost, the PDF cannot be opened and this tool cannot recover it. The password is not kept anywhere: not in the settings file, and not by this site.</p>
          </div>
          <div id="optCompress" data-part="compress">
            <p><label class="field">Compression
              <select id="cLevel">
                <option value="none">None</option>
                <option value="light">Light: best quality</option>
                <option value="recommended">Recommended</option>
                <option value="strong">Strong: smaller pictures</option>
                <option value="extreme">Extreme: rough pictures, text kept</option>
                <option value="maximum">Maximum: pages become pictures</option>
                <option value="custom">Custom…</option>
              </select></label></p>
            <p class="small muted" id="cSummary"></p>
            <div id="cCustom">
              <p><label class="field">Method
                <select id="cMode">
                  <option value="images">Shrink the pictures; text stays text</option>
                  <option value="flatten">Turn whole pages into pictures</option>
                  <option value="tidy">Tidy up only, no quality loss</option>
                </select></label></p>
              <p id="cDpiRow"><label class="field">Keep at most <input id="cDpi" type="number" min="36" max="600" step="1" inputmode="numeric" /> dots per inch</label><br /><span class="small muted">Fewer dots: smaller file, blurrier pictures.</span></p>
              <p id="cQualityRow"><label class="field">Picture quality <input id="cQuality" type="number" min="10" max="100" step="1" inputmode="numeric" /> %</label><br /><span class="small muted">Lower: smaller file, more blockiness.</span></p>
              <p id="cGreyRow"><label><input id="cGrey" type="checkbox" /> Make pictures grey (no colour)</label></p>
            </div>
            <p class="small notice" id="cFlattenWarn"><strong>Text will become part of a picture:</strong> it can no longer be selected, searched or read aloud by a screen reader, and links stop working. Small print may become hard to read.</p>
          </div>
          <details id="optImageDpi" data-part="imageDpi">
            <summary>Size of images on the page</summary>
            <div class="details-body">
              <label class="field">Treat images as <input id="imageDpi" type="number" min="36" max="600" step="1" inputmode="numeric" /> dots per inch</label>
              <p class="small muted">An image has pixels but no fixed paper size. At 96 dots per inch, an image 960 pixels wide becomes a page 10 inches (25.4 cm) wide. A higher number makes a smaller page; the image's detail is unchanged.</p>
            </div>
          </details>
          <p><label class="field">File name <input id="outName" type="text" size="16" /></label><br /><span class="small muted">Starts out different from your original's name, so the original isn't replaced.</span></p>
        </div>

        <p id="status" class="notice info small" role="status" aria-live="polite" hidden></p>
        <div id="ask" class="notice sans ask" role="alertdialog" aria-label="Same name as an original file" hidden></div>
        <div id="result" class="result sans" hidden></div>
        <div class="go">
          <button type="button" class="primary big" id="saveAll">{task.action}</button>
          <button type="button" id="saveSel" data-needs-sel>Save the selected pages</button>
        </div>

        <details class="later">
          <summary>Carry on later</summary>
          <div class="details-body sans">
