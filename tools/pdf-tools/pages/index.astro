---
import ToolLayout from "@site/layouts/ToolLayout.astro";
import { CSP } from "../web/csp.ts";
import { TASKS, WORKSPACE, NOT_BUILT } from "../web/tasks.ts";
const base = import.meta.env.BASE_URL;
const home = `${base}tools/pdf-tools/`;
const policy = import.meta.env.PROD ? CSP : "";
const groups = ["Organise", "Convert from PDF", "Convert to PDF"] as const;
---
<ToolLayout slug="pdf-tools" page="index" description="Merge, split, rotate, reorder and resize PDFs, turn PDFs into images or text, and images into PDFs, all inside your browser. Your files are never uploaded.">
  {policy && <meta slot="head" http-equiv="Content-Security-Policy" content={policy} />}
  <div id="pdfhome">
    <div class="top">
      <h1>PDF tools that keep your files on your device</h1>
      <p class="lede">Merge, split, rotate and convert PDFs. Everything is done by your own browser: nothing is uploaded, because this site has nowhere to upload to. <a href={`${home}methods/`}>How to check that</a>.</p>
    </div>
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.replace(/\s+/g, "-")}`}>
        <h2 id={`g-${g.replace(/\s+/g, "-")}`}>{g}</h2>
        <ul class="tasks">
          {TASKS.filter((t) => t.group === g).map((t) => (
            <li><a class="task" href={`${home}${t.slug}/`}>
              <span class="ico" aria-hidden="true">{t.tag}</span>
              <span class="name">{t.name}</span>
              <span class="blurb">{t.blurb}</span>
            </a></li>
          ))}
        </ul>
      </section>
    ))}
    <section aria-labelledby="g-all">
      <h2 id="g-all">Several steps at once</h2>
      <ul class="tasks">
        <li class="wide"><a class="task" href={`${home}${WORKSPACE.slug}/`}>
          <span class="ico" aria-hidden="true">{WORKSPACE.tag}</span>
          <span class="name">{WORKSPACE.name}</span>
          <span class="blurb">{WORKSPACE.blurb}</span>
        </a></li>
      </ul>
    </section>
    <section aria-labelledby="g-soon">
      <h2 id="g-soon">Not built yet</h2>
      <p class="small sans muted">Planned, and listed here so you don't have to hunt for them. They will only be added if they can be done entirely on your device.</p>
      <ul class="tasks soon">
        {NOT_BUILT.map((t) => (
          <li><span class="task off">
            <span class="ico" aria-hidden="true">{t.tag}</span>
            <span class="name">{t.name}</span>
            <span class="blurb">Not built yet</span>
          </span></li>
        ))}
      </ul>
    </section>
    <p class="notice small">Early version (alpha). Keep your original files, and check each result before relying on it. See <a href={`${home}methods/`}>Methods and limits</a>.</p>
  </div>

  <style is:global>
    #pdfhome .top { text-align: center; padding: 0.6rem 0 0.4rem; }
    #pdfhome .top .lede { max-width: 40em; margin-left: auto; margin-right: auto; }
    #pdfhome h2 { font-size: 1.15rem; margin: 1.4em 0 0.5em; border-bottom: 1px solid var(--line-soft); padding-bottom: 0.2em; }
    #pdfhome .tasks { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 12px; }
    #pdfhome .tasks .wide { grid-column: 1 / -1; }
    #pdfhome .task { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; align-items: center; height: 100%; padding: 14px; border: 1px solid var(--line-soft); border-radius: 6px; background: #fff; color: inherit; text-decoration: none; transition: border-color 0.2s, background 0.2s, transform 0.2s; }
    #pdfhome a.task:hover, #pdfhome a.task:focus-visible { border-color: var(--navy); background: var(--beige); transform: translateY(-2px); }
    #pdfhome .ico { grid-row: 1; width: 2.6rem; height: 3.1rem; display: flex; align-items: center; justify-content: center; font-family: var(--sans); font-weight: 700; font-size: 0.8rem; color: #fff; background: var(--navy); border-radius: 3px 10px 3px 3px; }
    #pdfhome .name { font-weight: 700; font-size: 1.08rem; color: var(--navy); line-height: 1.2; }
    #pdfhome .blurb { grid-column: 1 / -1; font-family: var(--sans); font-size: 0.88rem; color: var(--muted); align-self: start; }
    #pdfhome .task.off { background: #fafafa; border-style: dashed; }
    #pdfhome .task.off .ico { background: #999; }
    #pdfhome .task.off .name { color: var(--muted); }
    #pdfhome .soon { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
  </style>
</ToolLayout>
