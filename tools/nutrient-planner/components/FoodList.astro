---
// "Choose foods": the preset buttons, search box and the tree of foods (filled in by web/ui/food-list.ts).
// Shared by the Planner and Food Finder pages, so a change here shows on both. `single`: Food Finder's version,
// where one food is picked (no presets, and the list starts open).
interface Props { single?: boolean }
const { single = false } = Astro.props;
---
<details id="foodsBox" open={single}>
  <summary>{single ? "Choose a food" : "Choose foods"} <span class="summary-note" id="foodsNote"></span></summary>
  <div class="details-body">
    {!single && (
      <div class="preset-row sans">
        <span>Start from:</span>
        <button type="button" class="small" data-base="common">Common foods</button>
        <button type="button" class="small" data-base="wider">Wider selection</button>
        <button type="button" class="small" data-base="all">Everything</button>
        <button type="button" class="small" data-base="none">Nothing</button>
      </div>
    )}
    <label class="sr-only" for="foodSearch">Search foods</label>
    <input type="search" id="foodSearch" placeholder="Search all foods, e.g. lentils, salmon, cheddar" autocomplete="off" />
    {single
      ? <p class="small muted sans">Search, or open a category, and pick one food. Each food is listed once per food data source: USDA, and, for some foods, a blend of USDA and UK CoFID values, marked “blended, beta”. Common foods are marked <span class="tag">common</span>.</p>
      : <p class="small muted sans">Tick a category to switch all of it on or off, or open it to choose individual foods. Common foods are marked <span class="tag">common</span>.</p>}
    <div id="foodTree"></div>
  </div>
</details>
