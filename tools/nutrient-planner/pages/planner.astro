---
import ToolLayout from "@site/layouts/ToolLayout.astro";
import Caveat from "@site/components/Caveat.astro";
import YouFields from "../components/YouFields.astro";
import FoodList from "../components/FoodList.astro";
import ShareBox from "../components/ShareBox.astro";
import "../web/ui/page.css";
import { site } from "@site/site.config.ts";
const base = import.meta.env.BASE_URL;
const tool = `${base}tools/nutrient-planner/`;
---
<ToolLayout slug="nutrient-planner" page="planner" description="Find a handful of everyday foods that together come close to a day's recommended nutrients, or build your own day and see how it measures up.">
  <h1>Nutrient planner</h1>
  <p class="lede">Find a handful of everyday foods that together come close to a day's recommended nutrients, or build your own day and see how it measures up.</p>

  <div id="planner" data-base={base} data-data={`${tool}data/`} data-refresh-url={site.issueUrl("nutrient-planner-data-refresh.yml", "Data refresh request: nutrient planner")} data-methods-url={`${tool}methods/`} data-privacy-url={`${base}privacy/`}>
    <noscript><p class="notice">The planner runs in your browser and needs JavaScript.</p></noscript>
    <p id="loading" class="muted">Loading food data…</p>

    <div id="app" hidden>
      <!-- 1. About you -->
      <section class="panel" aria-labelledby="h-you">
        <h2 id="h-you">1. About you</h2>
        <YouFields />
      </section>

      <!-- 2. Foods -->
      <section class="panel" aria-labelledby="h-foods">
        <h2 id="h-foods">2. Foods</h2>
        <div class="food-head">
          <div class="segmented" role="radiogroup" aria-label="Diet">
            <label><input type="radio" name="diet" value="none" /><span>No restriction</span></label>
            <label><input type="radio" name="diet" value="vegetarian" /><span>Vegetarian</span></label>
            <label><input type="radio" name="diet" value="vegan" /><span>Vegan</span></label>
          </div>
          <span class="sans" id="foodCount"></span>
        </div>
        <div class="food-head">
          <div class="segmented" role="radiogroup" aria-label="Food data">
            <label><input type="radio" name="source" value="usda" /><span>USDA data</span></label>
            <label><input type="radio" name="source" value="blend" /><span>USDA + UK CoFID, blended</span></label>
          </div>
          <span class="small muted sans" id="sourceStatus" role="status" aria-live="polite"></span>
        </div>
        <Caveat kind="beta" id="blendNote" hidden>For foods found to be the same food in the USDA and UK (CoFID) tables, each nutrient is the median of the tables, with the range shown; the foods are marked <span class="tag">blended</span>. Matches and values were made by automated steps without manual human verification. Some nutrients are defined differently by each target standard, so the values follow the standard you chose. All other foods use the USDA data unchanged. <a href="https://github.com/mehfoos/halfbakedtools/tree/main/tools/nutrient-planner/pipeline/blend">How the blend is made</a></Caveat>
        <FoodList />
      </section>

      <!-- 3. Plan -->
      <section class="panel" aria-labelledby="h-plan">
        <h2 id="h-plan">3. Plan your day</h2>
        <div class="segmented mode" role="radiogroup" aria-label="Mode">
          <label><input type="radio" name="mode" value="suggest" /><span>Suggest foods for me</span></label>
          <label><input type="radio" name="mode" value="build" /><span>Build my own</span></label>
        </div>

        <div id="suggestPane">
          <div class="run-row sans">
            <label>Up to <input type="number" id="n" min="1" max="15" step="1" inputmode="numeric" /> different foods</label>
            <label>Show <input type="number" id="options" min="1" max="50" step="1" inputmode="numeric" /> options</label>
            <button type="button" class="primary" id="run">Find combinations</button>
            <button type="button" id="stop" hidden>Stop</button>
            <span id="status" class="muted small" role="status" aria-live="polite"></span>
          </div>
          <p class="small sans"><label><input type="checkbox" id="vitd" /> Also try to reach the vitamin D target from food</label>
            <span class="muted">(off by default: few foods have much, and the usual advice is sunlight and a supplement)</span></p>
          <div id="results"></div>
        </div>

        <div id="buildPane" hidden>
          <p class="sans small">Add the foods you plan to eat in a day and their amounts. The charts update as you go.</p>
          <div class="add-box">
            <label class="sr-only" for="addSearch">Add a food</label>
            <input type="search" id="addSearch" placeholder="Add a food: type to search" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="addList" />
            <ul id="addList" role="listbox" hidden></ul>
          </div>
          <div id="builderList"></div>
          <div id="builderResult"></div>
        </div>
      </section>

      <ShareBox />
    </div>
  </div>
</ToolLayout>

<script>
  import { start } from "../web/main.ts";
  start(document.getElementById("planner")!);
</script>
